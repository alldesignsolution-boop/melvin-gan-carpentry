# Melvin Gan Carpentry — environment variables
# Copy to .env for local dev, or set these in the Railway project's Variables tab.

# Admin login (the sole account). Code falls back to Melvin / MGCW26 if unset.
ADMIN_USER=Melvin
ADMIN_PASS=MGCW26

# Session cookie signing secret — set to a long random string in production.
SESSION_SECRET=change_me_to_a_long_random_string

# Facebook Messenger webhook (only if you wire up FB lead capture).
FB_VERIFY_TOKEN=melvin_webhook_secret
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here
